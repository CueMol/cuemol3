// -*-Mode: C++;-*-
//
// $Id: Scene.qif,v 1.38 2011/03/10 13:11:55 rishitani Exp $

#ifndef SCENE_QIF_INCLUDED
#define SCENE_QIF_INCLUDED

#include "Object.qif"
#include "Renderer.qif"
#include "View.qif"
#include <qlib/LScrCallBack.qif>
#include <qlib/ByteArray.qif>
#include <gfx/Color.qif>
#include "anim/AnimMgr.qif"

runtime_class Scene
{
  using Color; // <-- gfx::SolidColor
  client_hdr "Scene.hpp";
  client_name qsys::Scene;

  scriptable;
  smartptr;

  ////////////////////
  // Scene properties

  property integer uid => redirect(getUID, XXX) (readonly);
  property boolean modified => redirect(isModified, XXX) (readonly);

  property string name => redirect(getName, XXX) (readonly);

  /// Source path of this scene
  property string src => redirect(getSource, XXX) (readonly);
  /// Type name of source
  property string srctype => redirect(getSourceType, XXX) (readonly);
  /// Base path
  property string basePath => redirect(getBasePath, XXX) (readonly);

  property object<AbstractColor$> bgcolor => redirect(getBgColor, setBgColor);
  default bgcolor = gfx::SolidColor::createRGB(0.0, 0.0, 0.0);

  /// Screen-space ambient occlusion (GTAO) enable flag
  property boolean aoEnabled => redirect(isAOEnabled, setAOEnabled);
  default aoEnabled = false;

  /// GTAO occlusion sphere radius (view-space / world units)
  property real aoRadius => redirect(getAORadius, setAORadius);
  default aoRadius = 4.0;

  /// GTAO contrast (occlusion = pow(occlusion, aoIntensity))
  property real aoIntensity => redirect(getAOIntensity, setAOIntensity);
  default aoIntensity = 2.2;

  /// GTAO number of horizon slices (higher = smoother, slower)
  property integer aoSlices => redirect(getAOSlices, setAOSlices);
  default aoSlices = 9;

  /// GTAO number of steps marched per slice (radial samples)
  property integer aoSteps => redirect(getAOSteps, setAOSteps);
  default aoSteps = 3;

  /// Adaptive half-resolution GTAO: while the camera is moving, compute the AO
  /// term at half resolution (edge-aware upsampled on composite) for
  /// responsiveness, then re-render at full resolution once the view is still.
  /// Off-screen export is always full resolution. Off = always full resolution.
  property boolean aoHalfRes => redirect(isAOHalfRes, setAOHalfRes);
  default aoHalfRes = false;

  /// AO integration method (not saved; under evaluation): 0 = GTAO,
  /// 1 = visibility bitmask as in Blender EEVEE Next (aoRadius = search
  /// distance, aoSlices / aoSteps = slices / samples per side).
  property integer aoMethod => redirect(getAOMethod, setAOMethod) (nopersist);
  default aoMethod = 0;
  /// Visibility bitmask: constant minimum occluder thickness (A; EEVEE
  /// fast_gi_thickness_near).
  property real aoThicknessNear => redirect(getAOThicknessNear, setAOThicknessNear) (nopersist);
  default aoThicknessNear = 3.0;
  /// Visibility bitmask: strength of the near-field indirect diffuse light
  /// (the light the occluding surfaces reflect, gathered from the screen as
  /// EEVEE's horizon scan does). 0 = off.
  property real aoBounce => redirect(getAOBounce, setAOBounce) (nopersist);
  default aoBounce = 0.0;
  /// Visibility bitmask: darken the highlight by the AO too (specular
  /// occlusion, Frostbite / legacy EEVEE approximation).
  property boolean aoSpecOcclusion => redirect(isAOSpecOcclusion, setAOSpecOcclusion) (nopersist);
  default aoSpecOcclusion = true;
  /// Visibility bitmask: multiply by baked world-space ambient probes (the
  /// counterpart of EEVEE's volume light probes; rebuilt when the occluder
  /// spheres change) and their grid spacing (A).
  property boolean aoProbe => redirect(isAOProbe, setAOProbe) (nopersist);
  default aoProbe = true;
  /// Bake: number of directions (<= 64) and depth tile size (pixels).
  /// 32 / 128 halves the bake time of 64 / 256 with no visible difference
  /// (2BBV surface: 14 ms vs 40 ms, AO term correlation 0.987).
  property integer aoProbeDirs => redirect(getAOProbeDirs, setAOProbeDirs) (nopersist);
  default aoProbeDirs = 32;
  property integer aoProbeTile => redirect(getAOProbeTile, setAOProbeTile) (nopersist);
  default aoProbeTile = 128;
  property real aoProbeSpacing => redirect(getAOProbeSpacing, setAOProbeSpacing) (nopersist);
  default aoProbeSpacing = 3.0;
  /// Strength of the probe term: probe visibility = mix(1, probe,
  /// aoProbeStrength) (0 = no probe darkening, 1 = full); the AO term is the
  /// minimum of the screen-space and the probe visibility.
  property real aoProbeStrength => redirect(getAOProbeStrength, setAOProbeStrength) (nopersist);
  default aoProbeStrength = 1.0;
  /// Light intensities (not saved; PoC). lightAmbient = ambient total,
  /// lightSpecular = specular x material. Defaults are the former shader
  /// constants. With aoMethod 1 the AO darkens the ambient part only (as in
  /// Blender EEVEE) and the scene colour is kept unclamped until the composite.
  property real lightAmbient => redirect(getLightAmbient, setLightAmbient) (nopersist);
  default lightAmbient = 0.4;
  property real lightDiffuse => redirect(getLightDiffuse, setLightDiffuse) (nopersist);
  default lightDiffuse = 0.8;
  property real lightSpecular => redirect(getLightSpecular, setLightSpecular) (nopersist);
  default lightSpecular = 0.16;

  /// Debug view of the AO stage (not saved). off = the normal image,
  /// ao = the AO term in grayscale, normal = the normal fed to GTAO,
  /// depth = the linear depth.
  /// Applies to the live view and image export.
  enumdef aoDebugView {
    off = 0;
    ao = 1;
    normal = 2;
    depth = 3;
  }
  property enum aoDebugView => redirect(getAODebugView, setAODebugView) (nopersist);
  default aoDebugView = "off";

  /// Log the per-pass times of the off-screen frame pipeline (not saved;
  /// debugging). Each pass is followed by a GPU finish, so this slows down
  /// rendering while on.
  property boolean renderTiming => redirect(isRenderTiming, setRenderTiming) (nopersist);
  default renderTiming = false;

  /// Post-process anti-aliasing method, independent of the AO setting (either
  /// one routes the frame through the off-screen pipeline).
  /// none = direct rendering with hardware MSAA, fxaa = FXAA, smaa = SMAA.
  enumdef aa_method {
    none = 0;
    fxaa = 1;
    smaa = 2;
  }
  property enum aa_method => redirect(getAAMethod, setAAMethod);
  default aa_method = "fxaa";

  /// Temporal jitter supersampling level (0 = off, 1..5 = 2/4/8/16/32 samples).
  /// Accumulated only while the camera is still; resets on change.
  property integer aaJitterLevel => redirect(getAAJitterLevel, setAAJitterLevel);
  default aaJitterLevel = 0;

  /// SMAA edge-detection threshold (max RGB delta between neighbors). Lower =
  /// more edges antialiased; higher = only strong edges. 0.05 matches the SMAA
  /// "Ultra" preset (0.1 = Medium/High) -- molecular scenes need the lower
  /// value so object-object silhouettes with modest color contrast are caught.
  property real aaSmaaThreshold => redirect(getAASmaaThreshold, setAASmaaThreshold);
  default aaSmaaThreshold = 0.05;

  property string onload => m_scrOnLoadEvent;
  default onload = "";

  ////////////////////
  // Scene operations

  void setName(string);

  boolean isJustCreated();

  ////////////////////
  // Object manager

  /// Add new object to the scene (and returns new UID of object)
  integer addObject(object<Object$> obj);

  /// Get object by UID
  object<Object$> getObject(integer);

  /// Remove object
  boolean destroyObject(integer);

  /// Get object by name
  object<Object$> getObjectByName(string);

  void clearAllData() => clearAllDataScr;

  //property array objs => redirect(getObjArray, XXX) (readonly);
  property string obj_uids => redirect(getObjUIDList, XXX) (readonly);

  /// Get scene information in JSON format (ignore rend groups)
  string getObjectTreeJSON();

  /// Get scene information in JSON format (w/ rend groups)
  string getSceneDataJSON();

  property integer activeObjID => redirect(getActiveObjID, setActiveObjID) (nopersist);

  ////////////////////
  // Renderer related methods

  object<Renderer$> getRenderer(integer);

  /// Get the first matching renderer object by name
  object<Renderer$> getRendByName(string);

  property integer activeRendID => redirect(getActiveRendID, setActiveRendID) (nopersist);

  ////////////////////
  // View manager

  object<View$> createView();
  object<View$> getView(integer);
  object<View$> getViewByName(string);
  boolean destroyView(integer);
  // return the number of the bound views
  integer getViewCount();
  integer getUID();

  //property array views => redirect(getViewArray, XXX) (readonly);
  property string view_uids => redirect(getViewUIDList, XXX) (readonly);

  // property object<View$> activeView => redirect(getActiveView, XXX) (readonly, nopersist);
  property integer activeViewID => redirect(getActiveViewID, setActiveViewID) (nopersist);
  void setActiveViewID(integer);

  ////////////////////
  // Camera manager

  /// get copy of camera object
  object<Camera$> getCamera(string name);

  /// get reference of camera object
  object<Camera$> getCameraRef(string name);

  boolean hasCamera(string name);
  void setCamera(string, object<Camera$>);
  boolean destroyCamera(string name);

  boolean saveViewToCam(integer viewid, string nm);
  void loadViewFromCam(integer viewid, string nm);
  void loadViewFromCamAnim(integer viewid, string nm);

  string getCameraInfoJSON();

  /// Save camera to the local file
  boolean saveCameraTo(string camera_name, string filename);

  /// Load camera from the local file
  object<Camera$> loadCamera(string filename);

  ////////////////////
  // Application data store (<appdata> elements of the scene file)

  /// Get the app-data object for id (null when absent)
  object<LScrObject$> getAppData(string id);

  /// Get the app-data object for id, creating an instance of className if absent
  /// (holder creation is not an undoable edit; null when the class is unknown)
  object<LScrObject$> getCreateAppData(string id, string className);

  boolean hasAppData(string id);

  /// Remove the app-data entry (not undoable)
  boolean removeAppData(string id);

  ////////////////////
  // Undo manager

  boolean isUndoable();
  boolean isRedoable();
  string getUndoDesc(integer);
  string getRedoDesc(integer);
  integer getUndoSize();
  integer getRedoSize();

  void startUndoTxn(string descr);
  void commitUndoTxn();
  void rollbackUndoTxn();
  
  boolean undo(integer);
  boolean redo(integer);

  // clear all undo/redo data
  void clearUndoData() => clearUndoDataScr;

  // merge `count` adjacent undo steps into one, `start` steps below the
  // newest (0 is the newest); false when the range cannot be merged
  boolean mergeUndoSteps(integer start, integer count);

  ////////////////////
  // Animation manager
  object<AnimMgr$> getAnimMgr();

  ////////////////////
  // Color management & CMYK proofing

  property boolean use_colproof => redirect(isUseColProof, setUseColProof);
  default use_colproof = false;

  property string icc_filename => redirect(getIccFileName, setIccFileName);
  default icc_filename = "";

  enumdef icc_intent {
    perceptual = 0;
    relative_colorimetric = 1;
    saturation = 2;
    absolute_colorimetric = 3;
  }
  property enum icc_intent => redirect(getIccIntent, setIccIntent);
  default icc_intent = "perceptual";


  ////////////////////
  // Event

  integer addListener(object<LScrCallBack$>);
  boolean removeListener(integer nid);

  ////////////////////

  /// Execute javascript in this scene
  boolean execJSFile(string);

  void dump();

  string toString();
};

#endif

